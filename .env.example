# ──────────────────────────────────────────────
# Database (PostgreSQL via Prisma)
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/swiggy_clone?schema=public"

# ──────────────────────────────────────────────
# NextAuth.js
# ──────────────────────────────────────────────
NEXTAUTH_SECRET="change-me-to-a-random-32-char-string"
NEXTAUTH_URL="http://localhost:3000"

# ──────────────────────────────────────────────
# JWT (used for custom API auth)
# ──────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-32-char-string"

# ──────────────────────────────────────────────
# Google OAuth (optional – remove if not needed)
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ──────────────────────────────────────────────
# Razorpay (https://dashboard.razorpay.com/app/keys)
# NEXT_PUBLIC_RAZORPAY_KEY_ID  — safe to expose; goes into browser bundle
# RAZORPAY_KEY_SECRET          — server-only; NEVER expose to frontend
# ──────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
